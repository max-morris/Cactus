# /*@@
#   @file      make.config.rules.in
#   @date      Sun Jan 17 22:31:16 1999
#   @author    Tom Goodale
#   @desc 
#   Rules to generate object files from source files in another directory.
#
#   Note that, due to the (IMHO) rather bizarre way in which Make
#   deals with directories in the target names, this will
#   not work if the target is in a subdirectory.
#
#   @enddesc 
# @@*/

# Dividers to make the screen output slightly nicer
DIVEL   =  __________________
DIVIDER =  $(DIVEL)$(DIVEL)$(DIVEL)$(DIVEL)

# Define how to do a C compilation
define PREPROCESS_C
cat $< | $(PERL) $(C_FILE_PROCESSOR) $(CONFIG) > $(notdir $<)
endef

define COMPILE_C 
current_wd=`pwd` ; cd $(SCRATCH_BUILD) ; $(CC) $(CFLAGS) -c -o $$current_wd/$@ $$current_wd/$(notdir $<) $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DCCODE
endef

define POSTPROCESS_C
endef

# Define how to do a C++ compilation
define PREPROCESS_CXX
cat $< | $(PERL) $(CCTK_HOME)/lib/sbin/c_file_processor.pl $(CONFIG) > $(notdir $<)
endef

define COMPILE_CXX
current_wd=`pwd` ; cd $(SCRATCH_BUILD) ; $(CXX) $(CXXFLAGS) -c -o $$current_wd/$@ $$current_wd/$(notdir $<) $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DCCODE
endef

define POSTPROCESS_CXX
endef

# Define how to do a F77 compilation
define PREPROCESS_F77
cat $< | $(CPP) $(CPPFLAGS) $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DFCODE - | $(PERL) $(F_FILE_PROCESSOR) > $(notdir $<)
endef

define COMPILE_F77
current_wd=`pwd` ; cd $(SCRATCH_BUILD) ; $(F77) $(F77FLAGS) -c -o $$current_wd/$@ $$current_wd/$(notdir $<) $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DFCODE
endef

define POSTPROCESS_F77
endef

# Define how to do a F90 compilation
define PREPROCESS_F90
cat $< | $(CPP) $(CPPFLAGS) $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DFCODE - | $(PERL) $(F_FILE_PROCESSOR) > $(notdir $<)
endef

define COMPILE_F90
current_wd=`pwd` ; cd $(SCRATCH_BUILD) ; $(F90) $(F90FLAGS) -c -o $$current_wd/$@ $$current_wd/$(notdir $<) $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DFCODE
endef

define POSTPROCESS_F90
endef


# Build rules for C

%.o: $(SRCDIR)/%.c
	@echo $(DIVIDER)
	@echo Preprocessing $<
	$(PREPROCESS_C)
	@echo Compiling $<
	$(COMPILE_C)
	@echo Postprocessing $<
	$(POSTPROCESS_C)


%.d: $(SRCDIR)/%.c
	$(CPP) -M $(CFLAGS) $< $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DCCODE > $@

# Build rules for C++

%.o: $(SRCDIR)/%.cc 
	@echo $(DIVIDER)
	@echo Preprocessing $<
	$(PREPROCESS_CXX)
	@echo Compiling $<
	$(COMPILE_CXX)
	@echo Postprocessing $<
	$(POSTPROCESS_CXX)

%.o: $(SRCDIR)/%.C 
	@echo $(DIVIDER)
	@echo Preprocessing $<
	$(PREPROCESS_CXX)
	@echo Compiling $<
	$(COMPILE_CXX)
	@echo Postprocessing $<
	$(POSTPROCESS_CXX)

%.d: $(SRCDIR)/%.cc
	$(CPP) -M $(CFLAGS) $< $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DCCODE > $@

%.d: $(SRCDIR)/%.C
	$(CPP) -M $(CFLAGS) $< $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DCCODE > $@

# Build rules for F77

%.o: $(SRCDIR)/%.F77
	@echo $(DIVIDER)
	@echo Preprocessing $<
	$(PREPROCESS_F77)
	@echo Compiling $<
	$(COMPILE_F77)
	@echo Postprocessing $<
	$(POSTPROCESS_F77)

%.o: $(SRCDIR)/%.f77
	@echo $(DIVIDER)
	@echo Preprocessing $<
	$(PREPROCESS_F77)
	@echo Compiling $<
	$(COMPILE_F77)
	@echo Postprocessing $<
	$(POSTPROCESS_F77)

%.d: $(SRCDIR)/%.F77
	cat $< | $(CPP) -M $(F77FLAGS) $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DFCODE - > $@

%.d: $(SRCDIR)/%.f77
	cat $< | $(CPP) -M $(F77FLAGS) $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DFCODE - > $@

# Build rules for F90

%.o: $(SRCDIR)/%.F
	@echo $(DIVIDER)
	@echo Preprocessing $<
	$(PREPROCESS_F90)
	@echo Compiling $<
	$(COMPILE_F90)
	@echo Postprocessing $<
	$(POSTPROCESS_F90)

%.o: $(SRCDIR)/%.f
	@echo $(DIVIDER)
	@echo Preprocessing $<
	$(PREPROCESS_F90)
	@echo Compiling $<
	$(COMPILE_F90)
	@echo Postprocessing $<
	$(POSTPROCESS_F90)

%.d: $(SRCDIR)/%.F
	cat $< | $(CPP) -M $(F90FLAGS) $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DFCODE - > $@

%.d: $(SRCDIR)/%.f
	cat $< | $(CPP) -M $(F90FLAGS) $(INC_DIRS:%=-I%) $(EXTRA_DEFINES:%=-D%) -DFCODE - > $@
