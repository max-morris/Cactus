#! /bin/sh
#  /*@@
#    @file      uxpv4.1_ES
#    @date      Thu 06 Sep 2001
#    @author    Thomas Radke
#    @desc
#               Known-architectures file for Fujitsu VPP700
#    @enddesc
#    @version   $Header$
#  @@*/

if test "$CCTK_CONFIG_STAGE" = "preferred-compilers" ; then
  : ${F90=frt}
else
  # no way to generate dependencies on this machine
  : ${C_DEPEND='echo'}
  : ${CXX_DEPEND='$(C_DEPEND)'}
  : ${F_DEPEND='$(C_DEPEND)'}
  : ${F77_DEPEND='$(C_DEPEND)'}
  : ${C_DEPEND_OUT='> /dev/null; touch $@'}
  : ${CXX_DEPEND_OUT='$(C_DEPEND_OUT)'}
  : ${F_DEPEND_OUT='$(C_DEPEND_OUT)'}
  : ${F77_DEPEND_OUT='$(C_DEPEND_OUT)'}

  : ${C_OPTIMISE_FLAGS='-O -K4'}
  : ${CXX_OPTIMISE_FLAGS='$(C_OPTIMISE_FLAGS) -Klib'}
  : ${F77_OPTIMISE_FLAGS='-Kfast -Of'}
  : ${F90_OPTIMISE_FLAGS='$(F77_OPTIMISE_FLAGS)'}

  if test "$LD" = "CC" ; then
    # C++ compiler only takes static libs by default
    # but we also want socket lib
    : ${LIBS="fj90fv fj90f fj90 fj90f}
    : ${LDFLAGS="-d y /usr/lib/libsocket.so /usr/lib/libvfl.so"}
  else
    : ${LIBS="fj90fv fj90f fj90 socket"}
  fi

# MPI stuff
  if test -n "$MPI" ; then
    NATIVE_MPI_INC_DIRS="/usr/lang/mpi/include"
    NATIVE_MPI_LIB_DIRS="/usr/lang/mpi/lib"
    NATIVE_MPI_LIBS="mpi mp"
  fi

fi
