if test "$CCTK_CONFIG_STAGE" = "preferred-compilers" ; then

:

else

  : ${LIBS="m"}
#  : ${LIBDIRS="/opt/fortran90/lib/"}
  : ${C_DEPEND='$(CPP) -H$@ $(CPPFLAGS)'}
  : ${CXX_DEPEND='$(CPP) -H$@ $(CPPFLAGS)'}
  : ${F77_DEPEND='$(CPP) -H$@ $(CPPFLAGS)'}
  : ${F_DEPEND='$(CPP) -H$@ $(CPPFLAGS)'}
  : ${C_DEPEND_OUT='> /dev/null 2>$(basename $(@)).d; $(PERL) -pi -e "s,^,$(basename $(@)).o $(basename $(@)).d : ," $(basename $(@)).d' }
  : ${CXX_DEPEND_OUT='> /dev/null 2>$(basename $(@)).d; $(PERL) -pi -e "s,^,$(basename $(@)).o $(basename $(@)).d : ," $(basename $(@)).d'}
  : ${F_DEPEND_OUT='> /dev/null 2>$(basename $(@)).d; $(PERL) -pi -e "s,^,$(basename $(@)).o $(basename $(@)).d : ," $(basename $(@)).d'}
  : ${F77_DEPEND_OUT='> /dev/null 2> $(basename $(@)).d; $(PERL) -pi -e "s,^,$(basename $(@)).o $(basename $(@)).d : ," $(basename $(@)).d'}

fi
